{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/engineering_mastery_curriculum.schema.json",
  "title": "Python-first Engineering Mastery Curriculum",
  "description": "Structural format of supplied website content; semantic referential checks run in the package validator.",
  "type": "object",
  "required": [
    "schema_version",
    "dataset_id",
    "metadata",
    "learner_starting_profile",
    "level_definitions",
    "curriculum",
    "projects",
    "study_plan",
    "python_seven_day_starter",
    "resources",
    "progress_policy"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "dataset_id": {
      "type": "string"
    },
    "last_reviewed": {
      "type": "string",
      "format": "date"
    },
    "metadata": {
      "type": "object"
    },
    "learner_starting_profile": {
      "type": "object"
    },
    "principles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "level_definitions": {
      "type": "object",
      "required": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "curriculum": {
      "type": "array",
      "minItems": 10,
      "items": {
        "$ref": "#/$defs/discipline"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "study_plan": {
      "type": "object",
      "required": [
        "weeks",
        "parallel_routines"
      ]
    },
    "python_seven_day_starter": {
      "type": "object",
      "required": [
        "days"
      ]
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "progress_policy": {
      "type": "object"
    },
    "special_notes": {
      "type": "object"
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": [
        "id",
        "name",
        "status_default"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "status_default": {
          "const": "not_started"
        }
      }
    },
    "lab_step": {
      "type": "object",
      "required": [
        "id",
        "instruction"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        }
      }
    },
    "lab": {
      "type": "object",
      "required": [
        "id",
        "title",
        "steps",
        "expected_evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lab_step"
          },
          "minItems": 1
        },
        "expected_evidence": {
          "type": "string"
        }
      }
    },
    "assessment": {
      "type": "object",
      "required": [
        "id",
        "challenge",
        "rubric",
        "required_evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "challenge": {
          "type": "string"
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "unit": {
      "type": "object",
      "required": [
        "id",
        "level",
        "outcome",
        "skills",
        "lab",
        "assessment",
        "resource_ids",
        "prerequisite_unit_ids"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "level": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ]
        },
        "outcome": {
          "type": "string"
        },
        "learning_mode": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "minItems": 3,
          "items": {
            "$ref": "#/$defs/skill"
          }
        },
        "lab": {
          "$ref": "#/$defs/lab"
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "estimated_focus": {
          "type": "string"
        },
        "prerequisite_unit_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "track": {
      "type": "object",
      "required": [
        "id",
        "title",
        "why_it_matters",
        "prerequisite_unit_ids",
        "resource_ids",
        "levels"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "why_it_matters": {
          "type": "string"
        },
        "prerequisite_unit_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resource_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "levels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/unit"
          }
        }
      }
    },
    "discipline": {
      "type": "object",
      "required": [
        "id",
        "title",
        "goal",
        "priority",
        "tracks"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "now",
            "later"
          ]
        },
        "tracks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/track"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "stage",
        "related_unit_ids",
        "tasks",
        "required_evidence"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "related_unit_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "title"
            ]
          }
        },
        "required_evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resource": {
      "type": "object",
      "required": [
        "id",
        "title",
        "source_type",
        "url",
        "purpose"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source_type": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "purpose": {
          "type": "string"
        }
      }
    }
  }
}
